{
  "name": "BirdsWhere",
  "short_name": "BirdsWhere",
  "description": "In-browser bird & wildlife distribution and migration explorer, powered by the BirdNET Geomodel running client-side. Works offline once loaded.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#e9efec",
  "theme_color": "#0b1f2a",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "./?open-file=1",
      "name": "Point list (KML / KMZ / GeoJSON)",
      "accept": {
        "application/vnd.google-earth.kml+xml": [
          ".kml"
        ],
        "application/vnd.google-earth.kmz": [
          ".kmz"
        ],
        "application/geo+json": [
          ".geojson"
        ]
      },
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [
            "application/vnd.google-earth.kmz",
            "application/vnd.google-earth.kml+xml",
            "application/geo+json",
            ".kmz",
            ".kml",
            ".geojson"
          ]
        }
      ]
    }
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
